# Public site URL (used for canonical URLs, sitemap, OG). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). The anon/publishable key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=
# Use the "publishable" (sb_publishable_...) or legacy anon key. Never the service-role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Needed for inquiry inserts + admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional locally; required in production to get inquiry emails)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
